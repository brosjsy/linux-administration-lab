# Two-server lab: Ubuntu 24.04 and Rocky Linux 9 on a private network
Vagrant.configure("2") do |config|
  config.vm.synced_folder "..", "/vagrant"

  config.vm.define "ubuntu-srv" do |u|
    u.vm.box = "bento/ubuntu-24.04"
    u.vm.hostname = "ubuntu-srv"
    u.vm.network "private_network", ip: "192.168.56.10"
    u.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end
  end

  config.vm.define "rocky-srv" do |r|
    r.vm.box = "bento/rockylinux-9"
    r.vm.hostname = "rocky-srv"
    r.vm.network "private_network", ip: "192.168.56.20"
    r.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end
  end
end
